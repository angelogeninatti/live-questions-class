{
  "name": "live-questions-class",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-quiz",
    "test:rules": "firebase emulators:exec --only firestore --project demo-quiz \"tsx --test tests/firestore-rules.test.ts\"",
    "simulate": "tsx scripts/simulate-students.ts",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "dev:emulator": "VITE_USE_EMULATORS=true vite"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.37.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
