# Copia questo file in `.env.local` (ignorato da git) e incolla la configurazione
# della tua app web Firebase come JSON su UNA sola riga (chiavi tra virgolette).
# La stessa stringa va messa nella variabile `FIREBASE_CONFIG` del repository GitHub
# (Settings → Secrets and variables → Actions → Variables).
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# Opzionale: usa gli emulatori locali di Firebase invece del progetto reale
# (avviali con `npm run emulators`). In questo caso VITE_FIREBASE_CONFIG può mancare.
# VITE_USE_EMULATORS=true
